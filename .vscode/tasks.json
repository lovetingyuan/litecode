{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "rust:check",
      "type": "process",
      "command": "cargo",
      "args": ["check", "--manifest-path", "src-tauri/Cargo.toml", "--locked", "--all-targets"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "rust:test",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--manifest-path", "src-tauri/Cargo.toml", "--locked", "--all-targets"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$rustc"],
      "group": "test"
    },
    {
      "label": "ui:dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE.*ready",
          "endsPattern": "Local:.*1420"
        }
      }
    }
  ]
}
