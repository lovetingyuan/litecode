{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Tauri (Rust)",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": [
          "build",
          "--manifest-path",
          "src-tauri/Cargo.toml",
          "--locked",
          "--bin",
          "litecode"
        ],
        "filter": { "name": "litecode", "kind": "bin" }
      },
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ui:dev"
    }
  ]
}
