{
  "name": "litecode",
  "version": "0.2.1",
  "private": true,
  "description": "A super light version of VSCode.",
  "type": "module",
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:local": "tauri build --config \"{\\\"bundle\\\":{\\\"createUpdaterArtifacts\\\":false}}\"",
    "build:tools": "node tools/build-tools.mjs",
    "tauri": "tauri",
    "check": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit --tsBuildInfoFile tmp/tsconfig.node.tsbuildinfo && cargo check --locked --all-targets --manifest-path src-tauri/Cargo.toml",
    "lint": "oxlint --deny-warnings . && eslint --max-warnings 0 .",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:e2e": "node tools/verify-desktop.mjs",
    "release": "node tools/release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@codingame/monaco-vscode-api": "37.6.1",
    "@codingame/monaco-vscode-editor-api": "37.6.1",
    "@codingame/monaco-vscode-files-service-override": "37.6.1",
    "@codingame/monaco-vscode-languages-service-override": "37.6.1",
    "@pierre/trees": "1.0.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-log": "2.10.2",
    "@tauri-apps/plugin-opener": "2.7.3",
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "allotment": "1.20.6",
    "jsonc-parser": "3.3.1",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@37.6.1",
    "monaco-languageclient": "11.0.3",
    "monaco-languages": "npm:monaco-editor@0.57.0",
    "patch-package": "8.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "vscode": "npm:@codingame/monaco-vscode-extension-api@37.6.1",
    "vscode-jsonrpc": "9.0.3",
    "vscode-languageserver-protocol": "3.18.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.2",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vue/language-server": "3.3.14",
    "@vue/typescript-plugin": "3.3.14",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "playwright": "1.65.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vscode-css-languageservice": "6.3.10",
    "vscode-html-languageservice": "5.6.2",
    "vscode-json-languageservice": "5.7.2",
    "vscode-languageserver": "10.1.2",
    "vscode-languageserver-textdocument": "1.0.16"
  }
}
