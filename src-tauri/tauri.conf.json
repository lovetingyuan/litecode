{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiteCode",
  "version": "0.1.0",
  "identifier": "com.tingyuan.litecode",
  "build": {
    "beforeDevCommand": "npm run build:tools && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:tools && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LiteCode",
        "width": 1280,
        "height": 820,
        "minWidth": 700,
        "minHeight": 420,
        "decorations": false,
        "dragDropEnabled": false,
        "backgroundColor": "#1f1f1f"
      }
    ],
    "security": {
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: media: http: https:; media-src 'self' blob: media: http://media.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "tools/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0RjA4NDgxMEVDRDQxN0YKUldSL1FjME9nWVR3TkE2VTFsQVhidk41QkVPWDV2S2p5dVFtQ1M1bXYxNkhjYS83Q2dETEUwTWEK",
      "endpoints": [
        "https://github.com/lovetingyuan/litecode/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
